{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/arlas-web-components",
  "assets": ["./assets", {
   "input": "./src/lib/components/",
    "glob": "**/*.theme.scss",
    "output": "./assets/styles/theme"
  }],
  "allowedNonPeerDependencies": [
    "arlas-d3",
    "iv-viewer",
    "ng-lazyload-image",
    "numeral"
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
