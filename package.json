{
  "name": "arlas-web-components-demo",
  "version": "28.1.0-dev0",
  "license": "Apache-2.0",
  "workspaces": [
    "projects/arlas-components",
    "projects/arlas-map",
    "projects/arlas-mapbox",
    "projects/arlas-maplibre"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "test-components": "ng test arlas-web-components",
    "test-map": "ng test arlas-map",
    "test-mapbox": "ng test arlas-mapbox",
    "test-maplibre": "ng test arlas-maplibre",
    "test": "npm run test-components && npm run test-map && npm run test-maplibre && npm run test-mapbox",
    "lint-components": "ng lint arlas-web-components",
    "lint-map": "ng lint arlas-map",
    "lint-mapbox": "ng lint arlas-mapbox",
    "lint-maplibre": "ng lint arlas-maplibre",
    "lint": "npm run lint-components && npm run lint-map && npm run lint-mapbox && npm run lint-maplibre",
    "build-components": "ng build arlas-web-components --configuration production && cp -r patches dist/arlas-web-components",
    "build-map": "ng build arlas-map --configuration production && cp -r patches dist/arlas-map",
    "build-mapbox": "ng build arlas-mapbox --configuration production && cp -r patches dist/arlas-mapbox",
    "build-maplibre": "ng build arlas-maplibre --configuration production && cp -r patches dist/arlas-maplibre",
    "e2e": "ng e2e",
    "analyze": "webpack-bundle-analyzer dist/stats-es2015.json",
    "i18n:init-components": "ngx-translate-extract --input ./projects/arlas-components/src/lib --output ./projects/arlas-components/assets/i18n/template.json --key-as-default-value --replace --format json",
    "i18n:init-map": "ngx-translate-extract --input ./projects/arlas-map/src/lib ./projects/arlas-maplibre/src/lib ./projects/arlas-mapbox/src/lib --output ./projects/arlas-map/assets/i18n/template.json --key-as-default-value --replace --format json",
    "i18n:init": "npm run i18n:init-map && npm run i18n:init-components",
    "i18n:extract-components": "ngx-translate-extract --input ./projects/arlas-components/src/lib --output ./projects/arlas-components/assets/i18n/{en,fr,es}.json --format json",
    "i18n:extract-map": "ngx-translate-extract --input ./projects/arlas-map/src/lib ./projects/arlas-maplibre/src/lib ./projects/arlas-mapbox/src/lib --output ./projects/arlas-map/assets/i18n/{en,fr,es}.json --format json",
    "i18n:extract": "npm run i18n:extract-map && npm run i18n:extract-components",
    "postinstall": "patch-package",
    "license-check": "license-check-and-add check -f license-check-and-add.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.15",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.15",
    "@angular/compiler": "^20.3.15",
    "@angular/core": "^20.3.15",
    "@angular/forms": "^20.3.15",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.15",
    "@angular/platform-browser-dynamic": "^20.3.15",
    "@angular/router": "^20.3.15",
    "@mapbox/mapbox-gl-draw": "^1.4.3",
    "@mapbox/mapbox-gl-draw-static-mode": "^1.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@tmcw/togeojson": "~5.5.0",
    "@turf/area": "^6.5.0",
    "@turf/bbox": "^6.5.0",
    "@turf/center": "^6.5.0",
    "@turf/centroid": "^6.5.0",
    "@turf/circle": "^6.5.0",
    "@turf/clean-coords": "^7.0.0",
    "@turf/helpers": "^6.5.0",
    "@turf/length": "^6.5.0",
    "@turf/midpoint": "^6.5.0",
    "@turf/rhumb-bearing": "^6.5.0",
    "@turf/rhumb-destination": "^6.5.0",
    "@turf/transform-rotate": "^6.5.0",
    "@turf/transform-translate": "^6.5.0",
    "@types/mapbox-gl": "^1.6.3",
    "@types/tinycolor2": "^1.4.0",
    "arlas-d3": "12.3.0-beta.1",
    "core-js": "~3.26.1",
    "geojson-polygon-self-intersections": "1.2.1",
    "geojson-validation": "0.2.1",
    "iv-viewer": "^2.2.1",
    "jsts": "2.1.0",
    "jszip": "^3.2.1",
    "mapbox-gl": "^1.6.1",
    "maplibre-gl": "~5.7.0",
    "moment": "^2.29.4",
    "ng-lazyload-image": "^9.1.3",
    "numeral": "^2.0.6",
    "pmtiles": "4.3.0",
    "rxjs": "^7.4.0",
    "shpjs": "^4.0.4",
    "stream": "0.0.2",
    "tslib": "^2.3.0",
    "wellknown": "0.5.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.13",
    "@angular-eslint/builder": "~20.7.0",
    "@angular-eslint/eslint-plugin": "~20.7.0",
    "@angular-eslint/eslint-plugin-template": "~20.7.0",
    "@angular-eslint/schematics": "~20.7.0",
    "@angular-eslint/template-parser": "~20.7.0",
    "@angular/cli": "^20.3.13",
    "@angular/compiler-cli": "^20.3.15",
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@types/jasmine": "~3.10.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vendure/ngx-translate-extract": "^9.3.0",
    "eslint": "^9.39.1",
    "jasmine-core": "~3.10.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "license-check-and-add": "^4.0.5",
    "minimist": "~1.2.7",
    "ng-packagr": "^20.3.2",
    "ts-node": "~10.4.0",
    "node": "^24.10.1",
    "typescript": "~5.8.0",
    "webpack-bundle-analyzer": "^4.6.1"
  },
  "overrides": {
    "license-check-and-add": {
      "globby": "^11.0.0"
    }
  }
}
